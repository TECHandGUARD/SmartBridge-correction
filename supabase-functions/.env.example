# Server-only settings. Configure these in Supabase Edge Function secrets.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by hosted Supabase.
# Supply local values separately if running the functions locally.
APP_BASE_URL=
GEMINI_API_KEY=
# Choose a currently available model ID for your Google account; no retired fallback.
GEMINI_MODEL=
# The live notification implementation uses Resend. Repository placeholders do not.
RESEND_API_KEY=
